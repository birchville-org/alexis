{
  "name": "@birchville/alexis",
  "version": "0.2.0",
  "private": false,
  "description": "Universal philological vocabulary trainer, corpus reader, and dictionary hub",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:payer": "vue-tsc -b && vite build --base=/alexis/ --outDir=../Payer/docs/public/alexis --emptyOutDir",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "philology",
    "sanskrit",
    "hindi",
    "vocabulary-trainer",
    "spaced-repetition",
    "dictionary",
    "monier-williams",
    "corpus",
    "tauri"
  ],
  "author": "Marco Demarmels",
  "license": "MIT AND CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birchville-org/alexis.git"
  },
  "bugs": {
    "url": "https://github.com/birchville-org/alexis/issues"
  },
  "homepage": "https://github.com/birchville-org/alexis#readme",
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tauri-apps/cli": "^2.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
